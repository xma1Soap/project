[Unit]
Description=AI gateway channel quota controller (dry-run by default)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=channel-controller
Group=channel-controller
WorkingDirectory=/opt/channel-quota-controller
ExecStart=/opt/channel-quota-controller/venv/bin/python -m channel_quota_controller --config /etc/channel-quota-controller/config.json --channels /var/lib/channel-quota-controller/channels.json --events /var/lib/channel-quota-controller/events.jsonl --state /var/lib/channel-quota-controller/state.json --audit /var/log/channel-quota-controller/audit.jsonl --lock /run/channel-quota-controller/controller.lock
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/channel-quota-controller /var/log/channel-quota-controller /run/channel-quota-controller

[Install]
WantedBy=multi-user.target

